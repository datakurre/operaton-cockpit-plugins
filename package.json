{
  "name": "operaton-cockpit-plugins",
  "private": true,
  "version": "0.0.1",
  "scripts": {
    "build": "NODE_ENV=production rollup -c",
    "watch": "NODE_ENV=development rollup -w -c --sourcemap",
    "postinstall": "tmpdir=$(mktemp -d) && cp -r node_modules/@waylay/react-filter-box/* \"$tmpdir/\" && cd \"$tmpdir\" && npx pegjs src/grammar.pegjs && yarn && cp -r * \"/workspaces/operaton-cockpit-plugins/node_modules/@waylay/react-filter-box/\" && rm -rf \"$tmpdir\"",
    "prettier:check": "prettier --check \"src/**/{*.ts,*.tsx}\"",
    "prettier:format": "prettier --write \"src/**/{*.ts,*.tsx}\"",
    "upgrade": "npx npm-check-updates -u"
  },
  "importSort": {
    ".js, .jsx, .ts, .tsx": {
      "style": "module",
      "parser": "typescript"
    }
  },
  "dependencies": {
    "allotment": "^1.20.4",
    "bpmn-js": "^18.6.2",
    "camunda-bpmn-js-behaviors": "^1.10.0",
    "camunda-bpmn-moddle": "^7.0.1",
    "diagram-js": "^15.3.0",
    "final-form": "^5.0.0",
    "min-dash": "^4.2.3",
    "min-dom": "^5.1.1",
    "moment": "^2.30.1",
    "query-string": "^9.2.1",
    "react": "^18.3.0",
    "react-copy-to-clipboard": "^5.1.0",
    "react-datepicker": "^8.4.0",
    "react-dom": "^18.3.0",
    "react-final-form": "^7.0.0",
    "@waylay/react-filter-box": "https://github.com/waylayio/react-filter-box/archive/f0e07e636240615a3c4bf9cf81609051dce932e9.tar.gz",
    "react-icons": "^5.5.0",
    "react-jason": "^1.1.2",
    "react-modal": "^3.16.3",
    "react-table": "^7.8.0",
    "react-tabs": "^6.1.0",
    "svg-curves": "^1.0.0",
    "tiny-svg": "^4.1.3"
  },
  "devDependencies": {
    "@babel/core": "^7.28.0",
    "@babel/preset-react": "^7.27.1",
    "@babel/preset-typescript": "^7.27.1",
    "@rollup/plugin-alias": "^5.1.1",
    "@rollup/plugin-babel": "^6.0.4",
    "@rollup/plugin-commonjs": "^28.0.6",
    "@rollup/plugin-image": "^3.0.3",
    "@rollup/plugin-json": "^6.1.0",
    "@rollup/plugin-node-resolve": "^16.0.1",
    "@rollup/plugin-replace": "^6.0.2",
    "@rollup/plugin-typescript": "^12.1.4",
    "@types/bpmn-moddle": "^9.0.0",
    "@types/inherits": "2.0.0",
    "@types/react": "^18.3.0",
    "@types/react-copy-to-clipboard": "^5.0.7",
    "@types/react-dom": "^18.3.0",
    "@types/react-modal": "^3.16.3",
    "@types/react-table": "^7.7.20",
    "import-sort-style-module": "^6.0.0",
    "prettier": "^3.6.2",
    "prettier-plugin-import-sort": "0.0.7",
    "rollup": "^4.44.1",
    "rollup-plugin-scss": "^4.0.1",
    "sass": "^1.89.2",
    "tslib": "^2.8.1",
    "typescript": "^5.8.3"
  }
}
