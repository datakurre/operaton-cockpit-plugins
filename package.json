    "react-table": "^7.8.0",
    "react-tabs": "^6.1.0",
    "svg-curves": "^1.0.0",
    "tiny-svg": "^4.1.3"
  },
  "devDependencies": {
    "@babel/core": "^7.28.0",
    "@babel/preset-env": "^7.28.6",
