    "msw": "^2.12.7",
    "prettier": "^3.6.2",
    "prettier-plugin-import-sort": "0.0.7",
    "rollup": "^4.44.1",
    "rollup-plugin-scss": "^4.0.1",
    "sass": "^1.89.2",
    "ts-jest": "^29.4.6",
    "tslib": "^2.8.1",
