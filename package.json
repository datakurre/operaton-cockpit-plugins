{
  "name": "operaton-cockpit-plugins",
  "private": true,
  "version": "0.0.1",
  "scripts": {
    "build": "NODE_ENV=production rollup -c",
    "watch": "NODE_ENV=development rollup -w -c --sourcemap",
    "lint": "eslint src/",
    "lint:fix": "eslint src/ --fix",
    "lint:report": "eslint src/ --format json --output-file eslint-report.json",
    "typecheck": "tsc --noEmit",
    "prettier:check": "prettier --check \"src/**/{*.ts,*.tsx}\"",
    "prettier:format": "prettier --write \"src/**/{*.ts,*.tsx}\"",
    "check": "npm run typecheck && npm run lint && npm run prettier:check",
    "fix": "npm run lint:fix && npm run prettier:format",
    "upgrade": "npx npm-check-updates -u",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:ci": "jest --ci --coverage"
  },
  "importSort": {
    ".js, .jsx, .ts, .tsx": {
      "style": "module",
      "parser": "typescript"
    }
  },
  "dependencies": {
